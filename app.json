{
  "expo": {
    "name": "استودیو اینانا",
    "slug": "inannastudio",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "inannastudio",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0A18",
    "platforms": [
      "android"
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "router": {},
      "eas": {
        "projectId": "a5990e27-0d4b-4715-87e1-0c31ebe4babc"
      }
    },
    "android": {
      "package": "com.inannastudio.leads",
      "adaptiveIcon": {
        "backgroundColor": "#0E0A18",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0A18",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "hassanzadehsds-team"
  }
}
